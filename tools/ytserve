#!/usr/bin/env python3
"""tools/ytserve — the YouTube companion (D050).

The clock cannot play video (no codec, no audio path), so tapping a video in
its YouTube app POSTs here and the Mac opens it. Run it, note the IP it
prints, put that IP in the app's Setup > Companion IP (or
POST /youtube {"host":"<ip>"}).

    tools/ytserve            listen on :8999, open videos in the browser
"""
import json, os, shutil, socket, subprocess, sys, threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import browser_session as bsmod        # the remote-browser half (D057)

PORT = 8999

# One browser session, shared by the one device. Created on first /browse,
# rebuilt if its thread has exited (idle timeout or error).
_bs = None
_bs_lock = threading.Lock()

def get_browser():
    global _bs
    with _bs_lock:
        if _bs is None or not _bs.thread.is_alive():
            _bs = bsmod.BrowserSession()
        return _bs
# The clock decodes exactly this: baseline MJPEG, 320x180, ~12 fps (D053).
STREAM_ARGS = ["-an", "-vf", "scale=320:180", "-r", "12",
               "-q:v", "9", "-f", "mjpeg", "pipe:1"]

def my_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.168.0.1", 80))
        return s.getsockname()[0]
    finally:
        s.close()

class H(BaseHTTPRequestHandler):
    def _json_body(self):
        return json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))) or b"{}")

    def _reply(self, code, obj):
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(json.dumps(obj).encode())

    def do_POST(self):
        if self.path == "/browse":                       # navigate / stop (D057)
            if not bsmod.PLAYWRIGHT_OK:
                self._reply(503, {"ok": False,
                    "error": "playwright not installed - pip install playwright"}); return
            try:
                body = self._json_body()
            except Exception:
                self.send_error(400); return
            if body.get("stop"):
                with _bs_lock:
                    if _bs: _bs.push({"type": "nav", "url": "about:blank"})
                self._reply(200, {"ok": True, "stopped": True}); return
            s = get_browser()
            if "url" in body:  s.push({"type": "nav", "url": str(body["url"])})
            print(f"[browse] -> {body.get('url','(no url)')}")
            self._reply(200, {"ok": True}); return

        if self.path == "/browse/input":                 # tap / scroll / key / back...
            try:
                s = get_browser(); s.push(self._json_body())
            except Exception:
                self.send_error(400); return
            self._reply(200, {"ok": True}); return

        if self.path != "/play":
            self.send_error(404); return
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
            vid = str(body["id"])
            assert vid.replace("-", "").replace("_", "").isalnum() and len(vid) <= 15
        except Exception:
            self.send_error(400); return
        url = f"https://www.youtube.com/watch?v={vid}"
        print(f"[ytserve] opening {url}")
        subprocess.Popen(["open", url])
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(b'{"ok":true}')

    def do_GET(self):
        if self.path.startswith("/browse/stream"):       # pixels DOWN (D057)
            if not bsmod.PLAYWRIGHT_OK:
                self._reply(503, {"ok": False,
                    "error": "playwright not installed - pip install playwright"}); return
            from urllib.parse import urlparse, parse_qs
            q = parse_qs(urlparse(self.path).query)
            s = get_browser()
            try:
                s.set_size(int(q.get("w", [450])[0]), int(q.get("h", [540])[0]))
            except Exception:
                pass
            bsmod.stream_to(self, s)
            return
        if self.path == "/home":
            # The owner's REAL Home: yt-dlp reads the logged-in browser
            # session and returns their recommendations. Cookies never leave
            # this Mac; the clock receives ids and titles only (D054).
            if shutil.which("yt-dlp") is None:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"ok":false,"error":"yt-dlp not installed"}')
                return
            items, tried = [], []
            for browser in ("chrome", "firefox", "safari"):
                try:
                    out = subprocess.check_output(
                        ["yt-dlp", "--flat-playlist", "--playlist-end", "12",
                         "-j", "--cookies-from-browser", browser,
                         "https://www.youtube.com/feed/recommended"],
                        timeout=40, stderr=subprocess.DEVNULL).decode()
                    for line in out.splitlines():
                        try:
                            j = json.loads(line)
                            if j.get("id") and j.get("title"):
                                items.append({"id": j["id"], "title": j["title"][:80],
                                              "channel": (j.get("channel") or j.get("uploader") or "")[:26]})
                        except Exception:
                            pass
                    if items:
                        print(f"[ytserve] home: {len(items)} items via {browser} cookies")
                        break
                except Exception:
                    tried.append(browser)
            self.send_response(200 if items else 502)
            self.send_header("Content-Type", "application/json")
            self.end_headers()
            if items:
                self.wfile.write(json.dumps({"ok": True, "items": items}).encode())
            else:
                self.wfile.write(json.dumps({"ok": False,
                    "error": "no browser session found - open youtube.com and log in"
                             f" (tried {', '.join(tried)})"}).encode())
            return
        if self.path.startswith("/stream/"):
            vid = self.path[len("/stream/"):]
            if not (vid.replace("-", "").replace("_", "").isalnum() and len(vid) <= 15):
                self.send_error(400); return
            if shutil.which("yt-dlp") is None:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"ok":false,"error":"yt-dlp not installed - brew install yt-dlp"}')
                return
            try:
                # VIDEO-ONLY formats are fine - the clock has no audio and
                # ffmpeg drops it anyway. Demanding muxed ("best") failed on
                # every video that ships only adaptive streams, which is most
                # of modern YouTube (v1.33.0, owner-reported).
                url = subprocess.check_output(
                    ["yt-dlp", "-g", "-f",
                     "bestvideo[height<=360]/bestvideo[height<=480]"
                     "/best[height<=480]/bestvideo/best",
                     f"https://www.youtube.com/watch?v={vid}"],
                    timeout=25).decode().strip().splitlines()[0]
            except Exception as e:
                self.send_error(502, f"yt-dlp failed: {e}"); return
            print(f"[ytserve] streaming {vid} to the clock")
            ff = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-i", url]
                                  + STREAM_ARGS, stdout=subprocess.PIPE)
            self.send_response(200)
            self.send_header("Content-Type", "video/x-motion-jpeg")
            self.end_headers()
            try:
                while True:
                    chunk = ff.stdout.read(8192)
                    if not chunk: break
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass                      # the clock hung up: stop or app exit
            finally:
                ff.kill()
                print(f"[ytserve] stream {vid} ended")
            return
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"ytserve ok\n")

    def log_message(self, *a):        # quiet
        pass

if __name__ == "__main__":
    ip = my_ip()
    print(f"[ytserve] listening on {ip}:{PORT} - set this IP as the clock's Companion IP")
    print(f'[ytserve]   curl -X POST http://flipclock.local/youtube -d \'{{"host":"{ip}"}}\'')
    ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
