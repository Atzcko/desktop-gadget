#!/usr/bin/env python3
"""tools/ytserve — the YouTube companion (D050).

The clock cannot play video (no codec, no audio path), so tapping a video in
its YouTube app POSTs here and the Mac opens it. Run it, note the IP it
prints, put that IP in the app's Setup > Companion IP (or
POST /youtube {"host":"<ip>"}).

    tools/ytserve            listen on :8999, open videos in the browser
"""
import json, shutil, socket, subprocess
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

PORT = 8999
# The clock decodes exactly this: baseline MJPEG, 320x180, ~12 fps (D053).
STREAM_ARGS = ["-an", "-vf", "scale=320:180", "-r", "12",
               "-q:v", "9", "-f", "mjpeg", "pipe:1"]

def my_ip():
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    try:
        s.connect(("192.168.0.1", 80))
        return s.getsockname()[0]
    finally:
        s.close()

class H(BaseHTTPRequestHandler):
    def do_POST(self):
        if self.path != "/play":
            self.send_error(404); return
        try:
            body = json.loads(self.rfile.read(int(self.headers.get("Content-Length", 0))))
            vid = str(body["id"])
            assert vid.replace("-", "").replace("_", "").isalnum() and len(vid) <= 15
        except Exception:
            self.send_error(400); return
        url = f"https://www.youtube.com/watch?v={vid}"
        print(f"[ytserve] opening {url}")
        subprocess.Popen(["open", url])
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.end_headers()
        self.wfile.write(b'{"ok":true}')

    def do_GET(self):
        if self.path.startswith("/stream/"):
            vid = self.path[len("/stream/"):]
            if not (vid.replace("-", "").replace("_", "").isalnum() and len(vid) <= 15):
                self.send_error(400); return
            if shutil.which("yt-dlp") is None:
                self.send_response(503)
                self.send_header("Content-Type", "application/json")
                self.end_headers()
                self.wfile.write(b'{"ok":false,"error":"yt-dlp not installed - brew install yt-dlp"}')
                return
            try:
                url = subprocess.check_output(
                    ["yt-dlp", "-g", "-f",
                     "best[height<=360][vcodec^=avc]/best[height<=360]/best",
                     f"https://www.youtube.com/watch?v={vid}"],
                    timeout=25).decode().strip().splitlines()[0]
            except Exception as e:
                self.send_error(502, f"yt-dlp failed: {e}"); return
            print(f"[ytserve] streaming {vid} to the clock")
            ff = subprocess.Popen(["ffmpeg", "-loglevel", "error", "-i", url]
                                  + STREAM_ARGS, stdout=subprocess.PIPE)
            self.send_response(200)
            self.send_header("Content-Type", "video/x-motion-jpeg")
            self.end_headers()
            try:
                while True:
                    chunk = ff.stdout.read(8192)
                    if not chunk: break
                    self.wfile.write(chunk)
            except (BrokenPipeError, ConnectionResetError):
                pass                      # the clock hung up: stop or app exit
            finally:
                ff.kill()
                print(f"[ytserve] stream {vid} ended")
            return
        self.send_response(200)
        self.end_headers()
        self.wfile.write(b"ytserve ok\n")

    def log_message(self, *a):        # quiet
        pass

if __name__ == "__main__":
    ip = my_ip()
    print(f"[ytserve] listening on {ip}:{PORT} - set this IP as the clock's Companion IP")
    print(f'[ytserve]   curl -X POST http://flipclock.local/youtube -d \'{{"host":"{ip}"}}\'')
    ThreadingHTTPServer(("0.0.0.0", PORT), H).serve_forever()
